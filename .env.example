# Public address of the site, without a trailing slash
SITE_URL=http://localhost:3000

# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=replace-with-a-long-random-string

# Local development connects to the docker-compose.yml database.
# In production, docker-compose.prod.yml builds DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/treeoflove

# Production database (docker-compose.prod.yml). Use letters and digits in the password.
POSTGRES_USER=treeoflove
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=treeoflove

# Port the site listens on, on the server
APP_PORT=3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
