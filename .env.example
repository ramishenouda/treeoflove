# Public site URL, no trailing slash.
# Local:  http://localhost:3000
# Prod:   https://www.treeoflove.life
SITE_URL=http://localhost:3000

# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Local development (matches docker-compose.yml).
# In production, docker-compose.prod.yml builds DATABASE_URL from POSTGRES_* below,
# so this line is unused when you deploy with ./deploy.sh.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/treeoflove

# Production database (docker-compose.prod.yml).
# Password: letters, digits, - and _ only (it goes into a connection URL).
POSTGRES_USER=treeoflove
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=treeoflove

# Port the app listens on on the server (reverse proxy → 127.0.0.1:APP_PORT)
APP_PORT=3000

# Stripe (leave empty until donations are ready)
# Local: sk_test_... / whsec_... from `stripe listen`
# Prod:  sk_live_... / whsec_... ; webhook URL:
#   https://www.treeoflove.life/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (leave empty until contact email is ready)
# Prod example: Tree of Love <hello@treeoflove.life>
# Verify the treeoflove.life domain in Resend first.
RESEND_API_KEY=
RESEND_FROM=
